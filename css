 body {
            font-family: 'Times New Roman', Times, serif, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #709af5;
        }
        div {
            max-width: 800px;
            margin: 50px auto;
            padding: 20px;
            background-color: #ca82fa;
            box-shadow: 4px 4px 10px rgba(0, 0, 0, 0.1);
            border-radius: 10px;
            border: 2ch solid #000;
        }
        h1, h2 {
            color: #181818;
        
        }

        h1 {
            font-size: 3em;
            margin-bottom: 20px;
            font-family: 'Times New Roman', Times, serif;
            text-align: center;
            border-bottom: 2px solid #000;
            border: 3px solid #000;
            background-color: #87d9ff;
        }
        p {
            color: #363636;
        }
        dialog {
            border: black solid 1px;
            border-radius: 5px;
            padding: 20px;
            background-color: #d87ffc;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }
        artwork{
            border: 1px solid #030303;
            margin-bottom: 20px;
            background-color: #bc4ffc;
            size: 20px;
            text-align: center;
            
        }
        music{
            border: 1px solid #070707;
            margin-bottom: 20px;
            background-color: #d393f8;
            size: 20px;
            text-align: center;
        }

        musicartists{
            border: 1px solid #0c0c0c;
            margin-bottom: 20px;
            background-color: #d393f8;
            size: 20px;
            text-align: left;
        }
        heading {
            background-color: #f880da;
            padding: 50px;
            text-align: center;
            border-bottom: 2px solid #000;
            border: 3px solid #000;
            border-radius: 10px;
            margin-bottom: 20px;
            margin-top: 20px;
            margin-left: 100px;
            margin-right: 100px;
        }
